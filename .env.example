# =================================================================
# LM Studio Telegram Bot Configuration
# =================================================================

# Required: Telegram Bot Token obtained from @BotFather
TELOXIDE_TOKEN=your_telegram_bot_token_here

# LM Studio Server URL (default: http://localhost:1234/v1)
LM_STUDIO_URL=http://localhost:1234/v1

# Optional: Default model ID. If commented or empty, the bot will auto-detect
# whatever model is currently loaded in LM Studio.
# LM_STUDIO_MODEL=llama-3.2-3b-instruct

# Default system prompt for new conversations
SYSTEM_PROMPT=You are a helpful, knowledgeable, and friendly AI assistant.

# Temperature for text generation (0.0 = deterministic, 2.0 = creative, default = 0.7)
TEMPERATURE=0.7

# Conversation memory: maximum number of conversation turns (user + assistant) to retain
MAX_HISTORY_TURNS=10

# Optional: Whitelist of authorised Telegram User IDs.
# Supports array format [id1, id2] or comma-separated id1, id2.
# If unset, any user who can message the bot can chat with your local model.
AUTHORISED_USERS=[123456789]
